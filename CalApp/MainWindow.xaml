<Window x:Class="CalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CalApp" Height="360" Width="340">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TxtA" Width="100" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtB" Width="100"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <Button Content="+" Width="60" Margin="0,0,5,0" Click="Add_Click"/>
            <Button Content="-" Width="60" Margin="0,0,5,0" Click="Subtract_Click"/>
            <Button Content="*" Width="60" Margin="0,0,5,0" Click="Multiply_Click"/>
            <Button Content="/" Width="60" Click="Divide_Click"/>
        </StackPanel>

        <TextBlock x:Name="TxtResult" Grid.Row="2" FontSize="18" Margin="0,0,0,10" Text="Result: "/>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
            <Button Content="Save History" Width="120" Margin="0,0,10,0" Click="SaveHistory_Click"/>
            <Button Content="Load History" Width="120" Click="LoadHistory_Click"/>
        </StackPanel>

        <ListBox x:Name="LstHistory" Grid.Row="4"/>
    </Grid>
</Window>